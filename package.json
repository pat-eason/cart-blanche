{
  "name": "cart-blanche",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:db": "docker compose up -d db",
    "dev:api": "cd apps/api && ADDR=:8787 go run .",
    "dev:web": "pnpm --filter @cart-blanche/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "up": "docker compose up -d --build",
    "down": "docker compose down"
  }
}
