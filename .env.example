# Local development: copy to .env if you want to change anything. Defaults just work.
# Host port for the web UI (http://localhost:8080)
WEB_PORT=8080

# Postgres password. Only read when the database volume is first created.
POSTGRES_PASSWORD=change-me

# Registration: open (anyone), invite (needs REGISTRATION_INVITE_CODE), or closed (nobody new).
REGISTRATION_MODE=open
REGISTRATION_INVITE_CODE=

# Production note: on the droplet, .env is created by the deploy workflow with a random
# POSTGRES_PASSWORD; COOKIE_SECURE defaults to true via docker-compose.prod.yml.
